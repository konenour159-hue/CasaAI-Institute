# Copier ce fichier en .env et renseigner de vraies valeurs en local.
# Ne JAMAIS committer le fichier .env réel (cf. cahier des charges technique §25).

APP_NAME="CASA AI Institute API"
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://casa:casa@localhost:5432/casa_dev
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

SECRET_KEY=change-me-generate-a-real-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379/0

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=casa-resources

# Laisser vide tant que l'orchestrateur IA (V5/V6) n'est pas en place.
AI_MODEL_URL=

# Origines autorisées en CORS quand ENVIRONMENT=production, séparées par des
# virgules (ex: https://app.casa-ai.fr,https://casa-ai.fr). Sans cette
# variable renseignée, l'API refuse toute requête cross-origin en production.
CORS_ALLOWED_ORIGINS=
