  "glossary": [
    {
      "term": "Agent IA",
      "en": "AI agent",
      "definition": "Système logiciel capable d’observer, choisir des actions et utiliser des outils pour atteindre un objectif."
    },
    {
      "term": "Apprentissage supervisé",
      "en": "Supervised learning",
      "definition": "Apprentissage à partir d’exemples associés à une cible connue."
    },
    {
      "term": "Biais",
      "en": "Bias",
      "definition": "Écart systématique pouvant produire des résultats défavorables ou inexacts."
    },
    {
      "term": "Chunk",
      "en": "Chunk",
      "definition": "Segment de document préparé pour l’indexation ou la recherche."
    },
    {
      "term": "Contexte",
      "en": "Context window",
      "definition": "Quantité d’information qu’un modèle peut traiter dans une interaction."
    },
    {
      "term": "Embedding",
      "en": "Embedding",
      "definition": "Représentation numérique d’un contenu dans un espace vectoriel."
    },
    {
      "term": "Fine-tuning",
      "en": "Fine-tuning",
      "definition": "Adaptation d’un modèle préentraîné à partir d’exemples ciblés."
    },
    {
      "term": "Garde-fou",
      "en": "Guardrail",
      "definition": "Règle ou mécanisme limitant les comportements indésirables d’un système IA."
    },
    {
      "term": "Hallucination",
      "en": "Hallucination",
      "definition": "Contenu produit sans fondement suffisant, mais présenté de manière plausible."
    },
    {
      "term": "Human in the loop",
      "en": "Human in the loop",
      "definition": "Organisation dans laquelle une personne valide ou contrôle certaines étapes."
    },
    {
      "term": "Lignage",
      "en": "Data lineage",
      "definition": "Traçabilité de l’origine, des transformations et des usages d’une donnée."
    },
    {
      "term": "LLM",
      "en": "Large language model",
      "definition": "Modèle de langage entraîné sur de grands volumes de données textuelles."
    },
    {
      "term": "LLMOps",
      "en": "LLMOps",
      "definition": "Pratiques de déploiement, suivi, évaluation et maintenance des applications à base de LLM."
    },
    {
      "term": "Matrice de confusion",
      "en": "Confusion matrix",
      "definition": "Tableau comparant classes réelles et classes prédites."
    },
    {
      "term": "MLOps",
      "en": "MLOps",
      "definition": "Pratiques d’industrialisation et de suivi des modèles de machine learning."
    },
    {
      "term": "Modèle multimodal",
      "en": "Multimodal model",
      "definition": "Modèle traitant plusieurs modalités telles que texte, image, audio ou vidéo."
    },
    {
      "term": "Prompt",
      "en": "Prompt",
      "definition": "Instruction et contexte transmis à un modèle génératif."
    },
    {
      "term": "RAG",
      "en": "Retrieval-augmented generation",
      "definition": "Architecture qui récupère des sources puis les fournit au modèle pour générer une réponse."
    },
    {
      "term": "Reranking",
      "en": "Reranking",
      "definition": "Reclassement des résultats de recherche par un modèle secondaire."
    },
    {
      "term": "Token",
      "en": "Token",
      "definition": "Unité de texte utilisée par un modèle de langage."
    },
    {
      "term": "Température",
      "en": "Temperature",
      "definition": "Paramètre influençant la diversité de la génération."
    },
    {
      "term": "Vector store",
      "en": "Vector database",
      "definition": "Système stockant des vecteurs et permettant la recherche par similarité."
    },
    {
      "term": "Dérive",
      "en": "Model drift",
      "definition": "Évolution des données ou relations qui dégrade la performance d’un modèle."
    },
    {
      "term": "Traçabilité",
      "en": "Traceability",
      "definition": "Capacité à reconstruire les données, décisions, versions et actions d’un système."
    }
