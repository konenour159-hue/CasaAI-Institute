# Copier en .env à la racine du projet (aux côtés de docker-compose.yml).
# Ne JAMAIS committer le fichier .env réel (cf. cahier des charges technique §25).

POSTGRES_USER=casa
POSTGRES_PASSWORD=casa
POSTGRES_DB=casa_dev
POSTGRES_PORT=5432

REDIS_PORT=6379

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Ces deux variables sont lues par app/core/config.py à l'intérieur du
# conteneur backend. En Docker, DATABASE_URL/REDIS_URL sont de toute façon
# surchargées par docker-compose.yml (hostnames internes `postgres`/`redis`) ;
# elles ne comptent vraiment que pour un lancement du backend hors Docker.
SECRET_KEY=change-me-generate-a-real-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ENVIRONMENT=development
DEBUG=true

# Origines autorisées en CORS quand ENVIRONMENT=production, séparées par des
# virgules (ex: https://app.casa-ai.fr). Sans cette variable, l'API refuse
# toute requête cross-origin en production.
CORS_ALLOWED_ORIGINS=
